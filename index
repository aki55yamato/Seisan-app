<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>精算管理アプリ</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 pb-20">

    <div class="max-w-xl mx-auto p-4">
        <header class="mb-4 text-center">
            <h1 class="text-xl font-bold text-gray-700">精算管理アプリ</h1>
            <p class="text-xs text-gray-500">あきたとちーたのお金のやり取りを記録するためのアプリです。</p>
        </header>

        <!-- タブ切り替えボタン -->
        <div class="flex border-b mb-4 bg-white rounded-t-xl overflow-hidden shadow-sm">
            <button id="btn-input" onclick="switchTab('input')" class="flex-1 py-3 text-center font-bold text-blue-600 border-b-2 border-blue-600 text-sm bg-blue-50">入力する</button>
            <button id="btn-list" onclick="switchTab('list')" class="flex-1 py-3 text-center font-bold text-gray-400 text-sm bg-white">一覧・精算結果</button>
        </div>

        <!-- ローディング表示 -->
        <div id="loading" class="text-center py-4 text-xs text-blue-600 font-bold" style="display: none;">データを読み込み中...</div>

        <!-- 【画面1】入力・編集画面 -->
        <div id="view-input" class="space-y-4">
            <div class="bg-white p-4 rounded-xl shadow-sm space-y-3">
                <h2 id="form-title" class="text-xs font-bold text-blue-600 mb-2">新規データを登録</h2>
                <input type="hidden" id="edit-id" value="">
                
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">日付</label>
                    <input type="date" id="date" class="w-full border rounded-lg p-2 text-sm bg-white">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">項目名</label>
                    <select id="title" class="w-full border rounded-lg p-2 text-sm bg-white">
                        <option value="食費">食費</option>
                        <option value="日用品">日用品</option>
                        <option value="雑貨">雑貨</option>
                        <option value="交際費">交際費</option>
                        <option value="外食">外食</option>
                        <option value="その他">その他</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">支払った人</label>
                    <select id="payer" class="w-full border rounded-lg p-2 text-sm bg-white">
                        <option value="ちーた">ちーた</option>
                        <option value="あきた">あきた</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">金額 (円)</label>
                    <input type="number" id="amount" placeholder="0" class="w-full border rounded-lg p-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">相手への請求割合</label>
                    <select id="ratio" class="w-full border rounded-lg p-2 text-sm bg-white">
                        <option value="0.5" selected>50%</option>
                        <option value="1">100%</option>
                        <option value="0.33">約33%</option>
                        <option value="0">0%</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">メモ</label>
                    <input type="text" id="memo" placeholder="例：11月分など" class="w-full border rounded-lg p-2 text-sm">
                </div>
                
                <!-- 登録ボタン -->
                <button onclick="saveItem()" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl shadow hover:bg-blue-700 transition text-sm">この内容で登録</button>
                
                <!-- 編集時のみ表示する削除ボタン -->
                <button id="delete-btn-in-form" onclick="deleteCurrentEditItem()" class="w-full bg-white border border-red-500 text-red-500 font-bold py-3 rounded-xl hover:bg-red-50 transition text-sm" style="display: none;">削除</button>
            </div>
        </div>

        <!-- 【画面2】一覧・精算結果画面 (上下分割テーブル) -->
        <div id="view-list" class="space-y-6" style="display: none;">
            <!-- 精算結果サマリー -->
            <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl text-center space-y-1 shadow-sm">
                <span class="text-xs text-emerald-700 font-bold">精算結果</span>
                <div id="result-text" class="text-base font-bold text-gray-800">計算中...</div>
            </div>

            <!-- ちーたの表 -->
            <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-red-100">
                <div class="bg-red-50 px-3 py-2 border-b border-red-100 flex justify-between items-center">
                    <span class="font-bold text-xs text-red-700">🔴 ちーたの支払い・請求</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" style="font-size: 11px;">
                        <thead>
                            <tr class="bg-gray-50 border-b text-gray-600">
                                <th class="p-2 border-r">日付</th>
                                <th class="p-2 border-r">項目</th>
                                <th class="p-2 border-r text-right">金額</th>
                                <th class="p-2 border-r text-center">割合</th>
                                <th class="p-2 border-r text-right">請求額</th>
                                <th class="p-2 border-r">メモ</th>
                                <th class="p-2 text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody id="chita-tbody">
                            <!-- JSで挿入 -->
                        </tbody>
                    </table>
                </div>
                <!-- 請求額合計 -->
                <div class="bg-gray-50 px-3 py-2 border-t text-right text-xs">
                    請求額合計: <span id="chita-total" class="font-bold text-red-600 text-sm">¥0</span>
                </div>
            </div>

            <!-- あきたの表 -->
            <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-blue-100">
                <div class="bg-blue-50 px-3 py-2 border-b border-blue-100 flex justify-between items-center">
                    <span class="font-bold text-xs text-blue-700">🔵 あきたの支払い・請求</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" style="font-size: 11px;">
                        <thead>
                            <tr class="bg-gray-50 border-b text-gray-600">
                                <th class="p-2 border-r">日付</th>
                                <th class="p-2 border-r">項目</th>
                                <th class="p-2 border-r text-right">金額</th>
                                <th class="p-2 border-r text-center">割合</th>
                                <th class="p-2 border-r text-right">請求額</th>
                                <th class="p-2 border-r">メモ</th>
                                <th class="p-2 text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody id="akita-tbody">
                            <!-- JSで挿入 -->
                        </tbody>
                    </table>
                </div>
                <!-- 請求額合計 -->
                <div class="bg-gray-50 px-3 py-2 border-t text-right text-xs">
                    請求額合計: <span id="akita-total" class="font-bold text-blue-600 text-sm">¥0</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ★ここに先ほど取得したGASのウェブアプリのURLを貼り付けてください
        const GAS_URL = "https://script.google.com/macros/s/AKfycbzCiOMV2xjvT82aKMrab6RCswGYsmTPg-c2_mISxt0GdwA_StzSo7R06Q7_XexubzlM/exec"; 

        let items = [];

        // 初期表示時は今日の日付を設定
        document.getElementById('date').valueAsDate = new Date();

        // 起動時にデータを取得
        fetchData();

        function switchTab(tabName) {
            const viewInput = document.getElementById('view-input');
            const viewList = document.getElementById('view-list');
            const btnInput = document.getElementById('btn-input');
            const btnList = document.getElementById('btn-list');

            if (tabName === 'input') {
                viewInput.style.display = 'block';
                viewList.style.display = 'none';
                btnInput.className = "flex-1 py-3 text-center font-bold text-blue-600 border-b-2 border-blue-600 text-sm bg-blue-50";
                btnList.className = "flex-1 py-3 text-center font-bold text-gray-400 text-sm bg-white";
            } else {
                viewInput.style.display = 'none';
                viewList.style.display = 'block';
                btnList.className = "flex-1 py-3 text-center font-bold text-blue-600 border-b-2 border-blue-600 text-sm bg-blue-50";
                btnInput.className = "flex-1 py-3 text-center font-bold text-gray-400 text-sm bg-white";
                fetchData(); // リスト表示時に最新データを再取得
            }
        }

        // スプレッドシートからデータを取得
        function fetchData() {
            const loading = document.getElementById('loading');
            loading.style.display = 'block';

            fetch(GAS_URL)
                .then(response => response.json())
                .then(data => {
                    items = data.map(item => ({
                        id: String(item.id),
                        date: item.date ? String(item.date).split('T')[0] : '',
                        title: item.title,
                        payer: item.payer,
                        amount: Number(item.amount),
                        ratio: Number(item.ratio),
                        memo: item.memo
                    }));
                    loading.style.display = 'none';
                    renderList();
                })
                .catch(error => {
                    console.error('データ取得エラー:', error);
                    loading.style.display = 'none';
                    alert('データの読み込みに失敗しました。URLを確認してください。');
                });
        }

        // 新規登録モードにフォームをリセット
        function resetFormForNew() {
            document.getElementById('edit-id').value = '';
            document.getElementById('form-title').innerText = '新規データを登録';
            document.getElementById('date').valueAsDate = new Date();
            document.getElementById('title').value = '食費';
            document.getElementById('payer').value = 'ちーた';
            document.getElementById('amount').value = '';
            document.getElementById('ratio').value = '0.5';
            document.getElementById('memo').value = '';
            document.getElementById('delete-btn-in-form').style.display = 'none';
        }

        // 編集モードでフォームを開く
        function editItem(id) {
            const item = items.find(i => String(i.id) === String(id));
            if (!item) return;

            document.getElementById('edit-id').value = item.id;
            document.getElementById('form-title').innerText = 'データを修正';
            document.getElementById('date').value = item.date;
            document.getElementById('title').value = item.title;
            document.getElementById('payer').value = item.payer;
            document.getElementById('amount').value = item.amount;
            document.getElementById('ratio').value = item.ratio;
            document.getElementById('memo').value = item.memo;
            document.getElementById('delete-btn-in-form').style.display = 'block';

            switchTab('input');
        }

        // 登録・更新処理（スプレッドシートに送信）
        function saveItem() {
            const editId = document.getElementById('edit-id').value;
            const date = document.getElementById('date').value;
            const title = document.getElementById('title').value;
            const payer = document.getElementById('payer').value;
            const amount = parseFloat(document.getElementById('amount').value);
            const ratio = parseFloat(document.getElementById('ratio').value);
            const memo = document.getElementById('memo').value;

            if (isNaN(amount) || amount <= 0) {
                alert('有効な金額を入力してください。');
                return;
            }

            const id = editId ? editId : String(Date.now());
            const itemData = { id, date, title, payer, amount, ratio, memo };

            const loading = document.getElementById('loading');
            loading.style.display = 'block';

            fetch(GAS_URL, {
                method: 'POST',
                body: JSON.stringify({ action: 'save', item: itemData })
            })
            .then(response => response.json())
            .then(result => {
                loading.style.display = 'none';
                resetFormForNew();
                switchTab('list');
            })
            .catch(error => {
                console.error('保存エラー:', error);
                loading.style.display = 'none';
                alert('データの保存に失敗しました。');
            });
        }

        // 編集画面からの削除処理
        function deleteCurrentEditItem() {
            const editId = document.getElementById('edit-id').value;
            if (!editId) return;

            if (confirm('このデータを削除してもよろしいですか？')) {
                const loading = document.getElementById('loading');
                loading.style.display = 'block';

                fetch(GAS_URL, {
                    method: 'POST',
                    body: JSON.stringify({ action: 'delete', id: editId })
                })
                .then(response => response.json())
                .then(result => {
                    loading.style.display = 'none';
                    resetFormForNew();
                    switchTab('list');
                })
                .catch(error => {
                    console.error('削除エラー:', error);
                    loading.style.display = 'none';
                    alert('データの削除に失敗しました。');
                });
            }
        }

        function renderList() {
            const chitaTbody = document.getElementById('chita-tbody');
            const akitaTbody = document.getElementById('akita-tbody');
            chitaTbody.innerHTML = '';
            akitaTbody.innerHTML = '';

            let chitaCredit = 0;
            let akitaCredit = 0;
            let chitaCount = 0;
            let akitaCount = 0;

            items.forEach(item => {
                const requestAmount = item.amount * item.ratio;
                let ratioText = (item.ratio * 100) + '%';
                if(item.ratio === 0.33) ratioText = '約33%';

                const tr = document.createElement('tr');
                tr.className = "border-b hover:bg-gray-50";
                tr.innerHTML = `
                    <td class="p-2 border-r whitespace-nowrap">${item.date}</td>
                    <td class="p-2 border-r whitespace-nowrap font-medium">${item.title}</td>
                    <td class="p-2 border-r text-right whitespace-nowrap">¥${item.amount.toLocaleString()}</td>
                    <td class="p-2 border-r text-center whitespace-nowrap">${ratioText}</td>
                    <td class="p-2 border-r text-right whitespace-nowrap font-semibold">¥${requestAmount.toLocaleString()}</td>
                    <td class="p-2 border-r text-gray-500">${item.memo || ''}</td>
                    <td class="p-2 text-center"><button onclick="editItem('${item.id}')" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1 rounded text-xs">編集</button></td>
                `;

                if (item.payer === 'ちーた') {
                    chitaCredit += requestAmount;
                    chitaTbody.appendChild(tr);
                    chitaCount++;
                } else {
                    akitaCredit += requestAmount;
                    akitaTbody.appendChild(tr);
                    akitaCount++;
                }
            });

            if (chitaCount === 0) {
                chitaTbody.innerHTML = '<tr><td colspan="7" class="text-center p-3 text-gray-400">データがありません</td></tr>';
            }
            if (akitaCount === 0) {
                akitaTbody.innerHTML = '<tr><td colspan="7" class="text-center p-3 text-gray-400">データがありません</td></tr>';
            }

            document.getElementById('chita-total').innerText = '¥' + Math.round(chitaCredit).toLocaleString();
            document.getElementById('akita-total').innerText = '¥' + Math.round(akitaCredit).toLocaleString();

            const diff = chitaCredit - akitaCredit;
            const resultText = document.getElementById('result-text');

            if (diff > 0) {
                resultText.innerHTML = `あきたがちーたに <span class="text-emerald-700 font-extrabold text-lg">¥${Math.round(diff).toLocaleString()}</span> 支払う`;
            } else if (diff < 0) {
                resultText.innerHTML = `ちーたがあきたに <span class="text-emerald-700 font-extrabold text-lg">¥${Math.round(Math.abs(diff).toLocaleString()}</span> 支払う`;
            } else {
                resultText.innerHTML = `現在、精算の差額はありません`;
            }
        }
    </script>
</body>
</html>
